# Primary Gemini API Key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Additional API keys for quota rotation (optional but recommended)
# Each key from a different Google account doubles your daily free quota.
GEMINI_API_KEY_2=your_second_gemini_api_key_here
# GEMINI_API_KEY_3=your_third_gemini_api_key_here

# YouTube cookies file path (optional - fixes IP block errors)
# Steps to generate:
#   1. Install "Get cookies.txt LOCALLY" Chrome extension
#   2. Open youtube.com while logged in
#   3. Click extension -> Export -> save as cookies.txt in backend/
#   4. Uncomment the line below:
# Authentication Configuration (Phase 1)
# Generate a secure 32+ byte random string for production (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# Legacy / Demo User Configuration (Optional - for testing & presentations)
DEMO_USER_EMAIL=demo@lectra.ai
DEMO_USER_NAME=Demo Student
DEMO_USER_PASSWORD=DemoPass123!
AUTO_MIGRATE_LEGACY_TASKS=true
