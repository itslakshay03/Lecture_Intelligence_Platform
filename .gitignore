# ================================================================
# LectraAI — root .gitignore
# Sub-directories keep their own .gitignore (backend/, frontend/,
# research/); this file covers cross-cutting and belt-and-suspenders
# rules so nothing sensitive or machine-specific can slip in.
# ================================================================

# ---- Dependencies / virtual environments ----
node_modules/
**/node_modules/
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/

# ---- Python caches / coverage ----
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# ---- Frontend build output (regenerable via `npm run build`) ----
frontend/dist/
dist/
dist-ssr/
*.local

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---- SECRETS (never commit) ----
.env
.env.*
!.env.example
backend/.env
cookies.txt
backend/cookies.txt

# ---- IDE / Local Tool Settings ----
.claude/
.vscode/
.idea/
*.suo
*.sw?
.DS_Store
Thumbs.db

# ---- Scratch & Temporary Renders ----
scratch/
research/paper/test_out.pdf
research/paper/test_builder.py

# ---- Runtime SQLite DB ----
backend/data/

# ---- Generated PDFs + transient PDF-render scratch ----
backend/output/*.pdf
backend/output/temp/
