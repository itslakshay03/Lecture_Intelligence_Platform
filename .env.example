# ================================================================
# LectraAI — Root Environment Variables Example
# Copy this file to `backend/.env` and fill in your actual credentials.
# NEVER commit your actual `.env` file to version control.
# ================================================================

# Primary Google Gemini API Key (required)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Additional Gemini API keys for quota rotation (optional)
# Each key from a different Google account provides additional daily free quota.
GEMINI_API_KEY_2=your_second_gemini_api_key_here
# GEMINI_API_KEY_3=your_third_gemini_api_key_here

# Optional YouTube cookies file path (for IP block avoidance in restricted environments)
# YOUTUBE_COOKIES_PATH=cookies.txt
